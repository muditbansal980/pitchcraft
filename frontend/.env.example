# URL of the FastAPI backend (server-side only)
BACKEND_URL=http://localhost:8000

# Cloudinary, for storing generated report PDFs (server-side only).
# Find these on the Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Canva ("Open in Canva") needs no frontend env: the keys live in backend/.env.
# Canva redirects to http://127.0.0.1:3000/api/canva/callback (register that exact URL
# on the integration; Canva rejects "localhost"). The session cookie is per host, so
# browse the app at http://127.0.0.1:3000, not http://localhost:3000, when using Canva.
