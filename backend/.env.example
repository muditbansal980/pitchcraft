# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./pitchcraft.db
# Postgres example (requires a driver, e.g. `uv add "psycopg[binary]"`):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pitchcraft
SQL_ECHO=false

# Chroma vector store (persisted locally)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=pitches
CHROMA_SERVICES_COLLECTION=wldd_services

# Source PDF for the services ingestion pipeline
SERVICES_PDF_PATH=../04-PitchCraft/Services Offered By WLDD.pdf
