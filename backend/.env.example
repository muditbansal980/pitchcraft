# SQLite (default, zero setup)
DATABASE_URL=sqlite:///./pitchcraft.db
# Postgres example (requires a driver, e.g. `uv add "psycopg[binary]"`):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pitchcraft
SQL_ECHO=false

# Chroma vector store (persisted locally)
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=pitches
CHROMA_SERVICES_COLLECTION=wldd_services

# Source PDF for the services ingestion pipeline
SERVICES_PDF_PATH=../04-PitchCraft/Services Offered By WLDD.pdf
# Folder with past_pitches.csv and decks/ for the past-pitches archive
ARCHIVE_DIR=../04-PitchCraft

# Tavily web research (get a key at https://app.tavily.com)
TAVILY_API_KEY=
RESEARCH_COUNTRY=india

# Groq LLM (free key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# JWT auth. Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=180
AUTH_COOKIE_SECURE=false

# --- v2: multi-model LLM routing --------------------------------------------
# Google AI Studio key (https://aistudio.google.com/apikey): strategist, editor, image picking
GOOGLE_API_KEY=
# Optional JSON overrides of role -> ordered "provider:model" lists (defaults in app/core/config.py)
# LLM_ROLES={"writer": ["groq:openai/gpt-oss-120b", "groq:openai/gpt-oss-20b"]}
# LLM_LIMITS={"groq:openai/gpt-oss-120b": {"tpm": 8000, "rpm": 30, "tpd": 200000}}

# --- v2: visuals ---------------------------------------------------------------
# Reddit trend pulse (create a "script" app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# TREND_SUBREDDITS=["IndianDankMemes", "indiameme", "bollywoodmemes", "IndiaCricket"]
# Imgflip meme captioning (free account at https://imgflip.com/signup)
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
# AI mock visuals: cloudflare | pollinations | none
IMAGE_GEN_PROVIDER=pollinations
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Downloaded/generated images, served at /media
MEDIA_DIR=./media

# --- v2: Canva Connect (https://www.canva.dev, scope design:content:write) ----------
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Register exactly this URL on the Canva integration, and browse the app at http://127.0.0.1:3000
# (not localhost): Canva rejects localhost and the session cookie is per host.
CANVA_REDIRECT_URI=http://127.0.0.1:3000/api/canva/callback
